{
  "name": "governworld-chrome-extension",
  "version": "0.1.1",
  "description": "GovernWorld Chrome Extension: Local-first PII/PHI detection, page visual masking, and flattened document redaction.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Andres Chavez Ramirez",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ACR-LOGIC/governworld-extension.git"
  },
  "funding": "https://buymeacoffee.com/governworld",
  "scripts": {
    "build": "node build.mjs",
    "build:firefox": "node scripts/build-firefox.mjs",
    "build:safari": "node scripts/build-safari.mjs",
    "build:all": "node build.mjs && node scripts/build-firefox.mjs && node scripts/build-safari.mjs",
    "preview": "node scripts/preview-server.mjs",
    "fixtures:photo": "node scripts/make-photo-fixtures.mjs",
    "test": "vitest run",
    "test:offline-ocr": "node scripts/verify-offline-ocr.mjs",
    "test:photo-e2e": "node tests/image-photo-e2e.browser.test.mjs",
    "test:doc-flow": "node scripts/verify-document-flow.mjs",
    "verify:browser": "node scripts/verify-browser.mjs && node tests/image-photo-e2e.browser.test.mjs",
    "capture:ui": "node scripts/capture-ui-session.mjs",
    "release:zip": "node scripts/make-release.mjs",
    "release:browsers": "node scripts/make-browser-releases.mjs",
    "typecheck": "tsc --noEmit",
    "sync:sidepanel": "node scripts/sync-sidepanel.mjs",
    "sync:sidepanel:check": "node scripts/sync-sidepanel.mjs --check",
    "capture:store": "node scripts/make-store-screenshots.mjs",
    "verify:zip": "node scripts/verify-release-zip.mjs",
    "verify:digests": "node scripts/verify-release-digests.mjs",
    "clean": "node scripts/housekeeping.mjs",
    "clean:apply": "node scripts/housekeeping.mjs --apply",
    "capture:promo": "node scripts/make-promo-tile.mjs",
    "icons": "node scripts/make-icons.mjs",
    "verify:print": "node scripts/verify-print-pipeline.mjs",
    "test:no-text": "node scripts/verify-no-text-reporting.mjs",
    "test:invocation": "node scripts/verify-invocation-feedback.mjs",
    "test:review": "node scripts/verify-review-surface.mjs"
  },
  "dependencies": {
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
