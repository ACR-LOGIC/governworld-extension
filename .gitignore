# Dependencies
node_modules/

# Build outputs
dist/
dist-firefox/
dist-safari/
build/
*.zip
*.crx
*.pem

# Release archives are build outputs, not source. The zip was already ignored
# and the tarball was not, which meant every packaging iteration added ~14 MB
# to the repository: seven tarballs are currently tracked, 100 MB of .git for
# artefacts that are reproducible from a commit. The repository tracks the
# *evidence* instead - release/SHA256SUMS and the digests recorded in
# RELEASE_EVIDENCE.md - and `npm run verify:digests` checks them.
release/*.tar.gz

# Test & coverage
coverage/
recordings/
.tmp*
*.log
*.traineddata
.playwright/
test-results/

# Environment and secrets
.env
.env.*
!.env.example
*.local
*.secret

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local AI agent workspaces
.agents/

# Generated release images (regenerable via scripts)
release/images/marquee-promo-tile-1400x560.png
release/images/store-icon-128x128.png
